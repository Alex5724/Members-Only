<header>
  <h1>Posts</h1>
</header>

<section aria-label="Lista postărilor">
  <% if (posts?.length > 0) { %> <% posts.forEach((post) => { %>
  <article>
    <h2><%= post.title %></h2>
    <p><%= post.description %></p>
    <p><%= post.created_at %></p>
  </article>
  <% }) %>
  <% } else { %>
  <p>No posts :(</p>
  <% } %>
</section>
