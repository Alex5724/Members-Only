<section class="posts" aria-label="Lista postărilor">
  <% if (posts?.length > 0) { %> <% posts.forEach((post) => { %>
  <article class="post">
    <h2><%= post.title %></h2>
    <p><%= post.description %></p>
    <p class="post-meta"><%= post.created_at %> by <%= post.author %></p>
  </article>
  <% }) %>
  <% } else { %>
  <p class="empty-posts">No posts :(</p>
  <% } %>
</section>
