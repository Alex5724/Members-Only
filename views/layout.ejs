<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members Only</title>
  </head>
  <body>
    <header>
      <h1>
        <% if(user) { %>
        <h1>
          Welcome,
          <%= user.name %>!
        </h1>
        <% } else{ %>
        <h1>Welcome, stranger!</h1>
        <% } %>
      </h1>
      <nav>
        <ul>
          <li>Login</li>
          <li>Sign up</li>
        </ul>
      </nav>
    </header>

    <main><%- body %></main>
  </body>
</html>
