<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/main.css" />
    <title>Members Only</title>
  </head>
  <body>
    <header>
      <h1>
        <% if (user) { %>
        Welcome,
        <%= user.name %>!
        <% } else { %>
        Welcome, stranger!
        <% } %>
      </h1>

      <nav>
        <ul>
          <li><a href="/login">Login</a></li>
          <li><a href="/register">Sign up</a></li>
        </ul>
      </nav>
    </header>

    <main><%- body %></main>
  </body>
</html>
